{
  "name": "dsh-llm-chatgpt-web",
  "version": "0.1.0",
  "description": "DSH LLM provider adapter for the local codex-chatgpt-web bridge",
  "author": "j955229",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/j955229/dsh-llm-chatgpt-web.git"
  },
  "homepage": "https://github.com/j955229/dsh-llm-chatgpt-web#readme",
  "bugs": {
    "url": "https://github.com/j955229/dsh-llm-chatgpt-web/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "npm run build && npm test",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": ["deepseek-harness", "dsh", "dsh-desktop", "chatgpt-web", "llm", "codex", "responses-api", "sse"],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-attachment": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-llm": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-workspace": "0.1.2-alpha.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-attachment": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-sandbox-policy": { "optional": true },
    "@deepseek-ai/dsh-session": { "optional": true },
    "@deepseek-ai/dsh-workspace": { "optional": true }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": { "node": ">=20" }
}
